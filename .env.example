# Copy this file to .env and fill in values. Never commit .env.

# UN Comtrade — subscription key (header: Ocp-Apim-Subscription-Key)
COMTRADE_API_KEY=

# Trade.gov Consolidated Screening List (header: Authorization Bearer)
TRADE_GOV_API_KEY=

# Used by adapters/usgs_parser.py (currently the same CSL adapter; header: Authorization Bearer)
USGS_API_KEY=

# SEC EDGAR — not a secret. Required User-Agent, e.g. "Your Name your.email@example.com"
SEC_EDGAR_USER_AGENT=
